[gd_scene format=3]

[ext_resource type="StyleBox" path="res://ToolBox.tres" id="1_panel"]

[sub_resource type="Theme" id="Theme_controls"]
default_font_size = 20
Label/colors/font_color = Color(0.22, 0.24, 0.27, 1)

[sub_resource type="StyleBoxFlat" id="Style_neutral"]
bg_color = Color(0.92, 0.95, 0.99, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[sub_resource type="StyleBoxFlat" id="Style_build"]
bg_color = Color(0.12, 0.46, 1, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[sub_resource type="StyleBoxFlat" id="Style_simulate"]
bg_color = Color(0, 0.72, 0.42, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[node name="SimulationControls" type="PanelContainer"]
anchors_preset = 10
anchor_left = 0.5
anchor_right = 0.5
offset_left = -265.0
offset_top = 16.0
offset_right = 265.0
offset_bottom = 100.0
grow_horizontal = 2
theme = SubResource("Theme_controls")
theme_override_styles/panel = ExtResource("1_panel")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Controls" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="BuildButton" type="Button" parent="Content/Controls"]
custom_minimum_size = Vector2(150, 56)
layout_mode = 2
tooltip_text = "Stop the current run and return to building."
theme_override_colors/font_color = Color(0.05, 0.1, 0.25, 1)
theme_override_colors/font_pressed_color = Color(1, 1, 1, 1)
theme_override_styles/normal = SubResource("Style_neutral")
theme_override_styles/pressed = SubResource("Style_build")
theme_override_styles/hover = SubResource("Style_build")
toggle_mode = true
button_pressed = true
text = "Build"

[node name="SimulateButton" type="Button" parent="Content/Controls"]
custom_minimum_size = Vector2(180, 56)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_disabled_color = Color(1, 1, 1, 1)
theme_override_styles/normal = SubResource("Style_simulate")
theme_override_styles/pressed = SubResource("Style_simulate")
theme_override_styles/hover = SubResource("Style_simulate")
theme_override_styles/disabled = SubResource("Style_simulate")
toggle_mode = true
text = "Simulate"

[node name="SaveButton" type="Button" parent="Content/Controls"]
custom_minimum_size = Vector2(150, 56)
layout_mode = 2
tooltip_text = "temp"
theme_override_colors/font_disabled_color = Color(0.45, 0.5, 0.6, 1)
theme_override_styles/disabled = SubResource("Style_neutral")
disabled = true
text = "Save"

[node name="Status" type="Label" parent="Content"]
visible = false
layout_mode = 2
autowrap_mode = 3
horizontal_alignment = 1
